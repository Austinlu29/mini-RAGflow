# API Key 只放在 .env 或环境变量中，不写入 Python 源码。
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
# 留空按模型名称识别；自定义服务/模型需填写实际容量（包含输入和输出）。
DEEPSEEK_CONTEXT_WINDOW=

# 多轮上下文：原始对话 gzip 打包保存于 SQLite，默认每次运行创建独立会话。
CONTEXT_ARCHIVE_DIR=data/context
CONTEXT_RECENT_TURNS=6
CONTEXT_RECALL_TOP_K=3
# 固定此值或运行 main.py --session ID 可在下次运行恢复同一会话。
CONTEXT_SESSION_ID=

# RAG：余弦相似度阈值需根据知识库实际检索结果调整。
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.65
RAG_MAX_CONTEXT_CHARS=12000
# 问答专用集合；留空使用后端默认集合，不影响 --index / --query / --check。
RAG_COLLECTION=

DASHSCOPE_API_KEY=your-api-key
# 北京地域的公共 DashScope 地址，也可以配置控制台提供的专属 API Host。
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com

# 云端 Milvus：从 Zilliz 集群详情页复制完整的公共 Endpoint。
VECTOR_STORE=milvus
MILVUS_URI=https://your-cluster-endpoint
# 可以使用 Zilliz API Key，或现有集群的 username:password。
MILVUS_TOKEN=your-zilliz-token
MILVUS_COLLECTION=miniragflow_chunks
